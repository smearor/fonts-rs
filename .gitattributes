book/** linguist-documentation
book/book/** linguist-generated=true

# Vendored resources must be byte-exact copies of upstream - disable
# all text normalization (CRLF files would otherwise be stored as LF
# blobs and fail `cargo xtask verify` on fresh checkouts).
crates/*/resources/** -text

*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.ftl text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.svg text eol=lf
